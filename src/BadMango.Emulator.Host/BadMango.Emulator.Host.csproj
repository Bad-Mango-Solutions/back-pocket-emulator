<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BadMango.Emulator.Host</RootNamespace>
    <Product>BackPocket Emulator - Host</Product>
    <Description>In-process host transport binding the host contracts to live machine instances.</Description>
    <PackageTags>emulator;host;loopback;machine;lifecycle;throttle</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BadMango.Emulator.Host.Contracts.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\machine-profile.schema.json" Link="Schemas\machine-profile.schema.json">
      <LogicalName>BadMango.Emulator.Host.Schemas.machine-profile.schema.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BadMango.Emulator.Host.Contracts\BadMango.Emulator.Host.Contracts.csproj" />
    <ProjectReference Include="..\BadMango.Emulator.Core\BadMango.Emulator.Core.csproj" />
    <ProjectReference Include="..\BadMango.Emulator.Debug.Infrastructure\BadMango.Emulator.Debug.Infrastructure.csproj" />
  </ItemGroup>

</Project>

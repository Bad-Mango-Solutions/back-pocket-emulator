<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BadMango.Emulator.Core</RootNamespace>

    <!-- Package Metadata -->
    <Product>BackPocket Emulator - Emulator Core</Product>
    <Description>Core interfaces for faithful 6502-family system emulation (ICpu, IMemory, IBus, IPeripheral).</Description>
    <PackageTags>applesoft;basic;interpreter;6502;emulator;apple2;core</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <!--
    GlobalUsings.cs, GlobalUsings.Bus.cs, and GlobalUsings.Emulation.cs each declare
    the Addr, DWord, and Word aliases. CS1537 is a hard error and cannot be suppressed.
    GlobalUsings.Bus.cs is a superset: those aliases plus global using BadMango.Emulator.Core.
    The other two files stay byte-identical and are not compiled; their directives are already in effect.
  -->
  <ItemGroup>
    <Compile Remove="GlobalUsings.cs" />
    <Compile Remove="GlobalUsings.Emulation.cs" />
    <None Include="GlobalUsings.cs" />
    <None Include="GlobalUsings.Emulation.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\*.json" LinkBase="profiles">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BadMango.Emulator.Core.Tests" />
    <InternalsVisibleTo Include="BadMango.Emulator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Update="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.CodeAnalysis.NetAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

{
    "$schema": "https://bad-mango-solutions.github.io/schemas/machine-profile.schema.json",
    "name": "pocket2e",
    "displayName": "Pocket2e",
    "description": "Pocket2e system with 48KB main RAM, system ROM at $D000-$FFFF, and peripheral emulation",

    "cpu": {
        "type": "65C02",
        "clockSpeed": 1020484
    },

    "addressSpace": 16,

    "memory": {
        "rom-images": [
            {
                "name": "system-rom",
                "source": "library://roms/pocket2e-system.rom",
                "size": "0x4000",
                "required": true,
                "on_verification_fail": "fallback"
            },
            {
                "name": "video-rom",
                "source": "library://roms/pocket2e-video.rom",
                "size": "0x1000",
                "required": true,
                "on_verification_fail": "fallback"
            }
        ],
        "physical": [
            {
                "name": "main-ram-48k",
                "size": "0xC000",
                "fill": "0x00"
            },
            {
                "name": "system-rom-16k",
                "size": "0x4000",
                "sources": [
                    {
                        "type": "rom-image",
                        "name": "system-rom",
                        "rom-image": "system-rom",
                        "offset": "0x0000"
                    }
                ]
            },
            {
                "name": "video-rom-4k",
                "size": "0x1000",
                "sources": [
                    {
                        "type": "rom-image",
                        "name": "video-rom",
                        "rom-image": "video-rom",
                        "offset": "0x0000"
                    }
                ]
            }
        ],
        "regions": [
            {
                "name": "main-ram",
                "type": "ram",
                "start": "0x0000",
                "size": "0xC000",
                "permissions": "rwx",
                "source": "main-ram-48k",
                "source-offset": "0x0000"
            },
            {
                "name": "io-page",
                "type": "composite",
                "start": "0xC000",
                "size": "0x1000",
                "handler": "composite-io"
            },
            {
                "name": "system-rom",
                "type": "rom",
                "start": "0xD000",
                "size": "0x3000",
                "permissions": "rx",
                "source": "system-rom-16k",
                "source-offset": "0x1000"
            }
        ]
    },

    "devices": {
        "motherboard": [
            {
                "type": "keyboard",
                "name": "Keyboard",
                "enabled": true,
                "config": {
                    "preset": "enhanced",
                    "autoRepeat": true
                }
            },
            {
                "type": "speaker",
                "name": "Speaker",
                "enabled": true,
                "config": {
                    "sampleRate": 48000
                }
            },
            {
                "type": "video",
                "name": "Video",
                "enabled": true,
                "config": {
                    "preset": "enhanced",
                    "colorMode": "ntsc"
                }
            },
            {
                "type": "gameio",
                "name": "Game I/O",
                "enabled": true,
                "config": {
                    "joystickDeadzone": 0.1
                }
            }
        ],
        "slots": {
            "enabled": true,
            "internalC3Rom": true,
            "internalCxRom": false,
            "cards": [
                {
                    "slot": 4,
                    "type": "pocketwatch",
                    "config": {
                        "timeSource": "host"
                    }
                },
                {
                    "slot": 6,
                    "type": "disk-ii-compatible",
                    "config": {
                        "drive1": null,
                        "drive2": null
                    }
                }
            ]
        }
    },

    "boot": {
        "autoStart": true
    }
}